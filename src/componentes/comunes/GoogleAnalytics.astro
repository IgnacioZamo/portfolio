---
/*
  Google Analytics 4 cargado con Partytown (en un web worker, para no frenar la página).
  Los eventos personalizados se envían desde src/scripts/analitica.js.
*/
// El ID se configura en src/data/sitio.js
import { GA_ID } from "@data/sitio.js";

// Solo en el sitio publicado: así las visitas mientras se desarrolla (npm run dev) no ensucian las métricas
const medir = import.meta.env.PROD;
---

{medir && (
  <>
    <script is:inline type="text/partytown" define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      // gtag se declara en window para que Partytown pueda reenviarle las llamadas hechas desde la página
      window.gtag = function gtag() { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("config", GA_ID);
    </script>
    <script is:inline type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  </>
)}
