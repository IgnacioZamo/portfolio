---
/*
  Header fijo de todas las páginas.
  - Desktop (≥1025px): enlaces a secciones + enlaces a páginas + redes + CV.
  - Mobile/tablet: botón hamburguesa que abre #menu-responsive (lógica en navBar.js).
*/
// Estilos de este componente
import "./Header.css";
import { iconos } from "@data/iconos.js";
import { CV_URL, REDES } from "@data/sitio.js";

// Secciones de la home: llevan "/" delante para que también funcionen desde las otras páginas
const secciones = [
  { href: "/#inicio", texto: "Inicio" },
  { href: "/#sobre-mi", texto: "Sobre mí" },
  { href: "/#contacto", texto: "Contacto" },
];
// Páginas propias: la hoja de vida y los desarrollos web, diferenciadas visualmente en el menú
const paginas = [
  { href: "/trayectoria", texto: "Trayectoria", icono: "experiencia" },
  { href: "/proyectos", texto: "Proyectos web", icono: "tecnologia" },
];

// Enlace activo al cargar: la página actual, o "Inicio" en la home (después lo actualiza navBar.js al hacer scroll)
const ruta = Astro.url.pathname.replace(/\/$/, "") || "/";
const esActivo = (href: string) => (ruta === "/" ? href === "/#inicio" : href === ruta);
const ariaCurrent = (href: string) => (!esActivo(href) ? undefined : href.includes("#") ? "true" : "page");
---

<header class="nav">
  <div class="nav-inner">
    <a href="/#inicio" class="logo" aria-label="zamoIgnacio, ir al inicio"><span class="br">&lt;</span>zamoIgnacio<span class="br">/&gt;</span></a>

    <nav class="links" aria-label="Principal">
      <div class="grupo">
        {secciones.map(({ href, texto }) => (
          <a href={href} data-nav-link class:list={{ active: esActivo(href) }} aria-current={ariaCurrent(href)}>{texto}</a>
        ))}
      </div>
      <span class="separador" aria-hidden="true"></span>
      <div class="grupo paginas">
        {paginas.map(({ href, texto, icono }) => (
          <a href={href} class:list={["pagina", { active: esActivo(href) }]} aria-current={ariaCurrent(href)}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={iconos[icono]} />
            {texto}
          </a>
        ))}
      </div>
    </nav>

    {/* Redes y CV; data-evento-* define lo que se mide en Analytics (ver src/scripts/analitica.js) */}
    <div class="nav-right">
      <a class="icon-btn" href={REDES.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (se abre en otra pestaña)" data-evento="clic_red_social" data-evento-red="github" data-evento-ubicacion="header"><i class="devicon-github-original" aria-hidden="true"></i></a>
      <a class="icon-btn" href={REDES.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (se abre en otra pestaña)" data-evento="clic_red_social" data-evento-red="linkedin" data-evento-ubicacion="header"><i class="devicon-linkedin-plain" aria-hidden="true"></i></a>
      <a class="btn btn-primary btn-sm btn-cv" href={CV_URL} data-evento="descargar_cv" data-evento-ubicacion="header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v3h16v-3"/></svg>
        Descargar CV
      </a>
      <button id="boton" class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-responsive">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menú mobile/tablet: lo controla navBar.js -->
  <nav id="menu-responsive" class="menu-movil" aria-label="Menú" hidden>
    {secciones.map(({ href, texto }) => (
      <a href={href} data-nav-link class:list={{ active: esActivo(href) }} aria-current={ariaCurrent(href)}>{texto}</a>
    ))}
    <div class="menu-paginas">
      {paginas.map(({ href, texto, icono }) => (
        <a href={href} class:list={["pagina", { active: esActivo(href) }]} aria-current={ariaCurrent(href)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={iconos[icono]} />
          {texto}
        </a>
      ))}
    </div>
    <div class="menu-redes">
      <a class="icon-btn" href={REDES.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (se abre en otra pestaña)" data-evento="clic_red_social" data-evento-red="github" data-evento-ubicacion="menu_movil"><i class="devicon-github-original" aria-hidden="true"></i></a>
      <a class="icon-btn" href={REDES.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (se abre en otra pestaña)" data-evento="clic_red_social" data-evento-red="linkedin" data-evento-ubicacion="menu_movil"><i class="devicon-linkedin-plain" aria-hidden="true"></i></a>
      <a class="btn btn-primary btn-sm" href={CV_URL} data-evento="descargar_cv" data-evento-ubicacion="menu_movil">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v3h16v-3"/></svg>
        Descargar CV
      </a>
    </div>
  </nav>
</header>

<script src="./navBar.js"></script>
