---
/*
  Sección Contacto (#contacto en la home): redes a la izquierda y formulario a la derecha.
  El formulario no usa backend: formulario.js arma un mailto con los datos.
*/
import { REDES } from "@data/sitio.js";
---

<section id="contacto" class="section" aria-labelledby="titulo-contacto">
  <div class="container">
    <div class="contact card">
      <div class="contact-copy">
        <span class="label">Contacto</span>
        <h2 id="titulo-contacto" class="titulo-seccion">Hablemos de tu <span class="grad">próximo proyecto</span></h2>
        <p>Actualmente estoy buscando nuevas oportunidades. Ya sea que tenga una pregunta o simplemente quiera saludar, ¡haré todo lo posible para responderle lo antes posible!</p>
        <ul class="socials">
          <li>
            <a href={REDES.linkedin} target="_blank" rel="noopener noreferrer" data-evento="clic_red_social" data-evento-red="linkedin" data-evento-ubicacion="contacto"><i class="devicon-linkedin-plain" aria-hidden="true"></i>LinkedIn</a>
          </li>
          <li>
            <a href={REDES.github} target="_blank" rel="noopener noreferrer" data-evento="clic_red_social" data-evento-red="github" data-evento-ubicacion="contacto"><i class="devicon-github-original" aria-hidden="true"></i>GitHub</a>
          </li>
          <li>
            <a href={REDES.whatsapp} target="_blank" rel="noopener noreferrer" data-evento="clic_red_social" data-evento-red="whatsapp" data-evento-ubicacion="contacto">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.6 2.1 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.2Z"/></svg>
              WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <!-- El envío arma un mailto con los datos: ver formulario.js -->
      <form id="formulario" class="form">
        <div class="two">
          <label for="nombre">Nombre
            <input name="nombre" id="nombre" type="text" placeholder="Tu nombre" autocomplete="name" required>
          </label>
          <label for="telefono">Teléfono
            <input name="telefono" id="telefono" type="tel" placeholder="+54 ..." autocomplete="tel">
          </label>
        </div>
        <label for="email">E-mail
          <input name="email" id="email" type="email" placeholder="tu@email.com" autocomplete="email" required>
        </label>
        <label for="mensaje">Mensaje
          <textarea name="mensaje" id="mensaje" rows="5" placeholder="Contame brevemente qué necesitás..." required></textarea>
        </label>
        <button type="submit" class="btn btn-primary">
          Enviar mensaje
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 28px 22px;
  }
  .contact-copy p { margin-top: 18px; font-size: 17px; color: var(--muted); }

  .socials { display: flex; flex-direction: column; gap: 10px; margin-top: 30px; list-style: none; }
  .socials a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(7, 12, 22, .45);
    font-weight: 500;
    transition: .2s;
  }
  .socials a:hover { border-color: var(--line-strong); color: var(--teal); }
  .socials i { font-size: 18px; }

  .form { display: grid; gap: 16px; align-content: start; }
  .two { display: grid; grid-template-columns: 1fr; gap: 16px; }
  label { display: grid; gap: 8px; font-size: 14px; font-weight: 500; color: var(--muted); }
  input,
  textarea {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(7, 12, 22, .6);
    font: 15px var(--f-body);
    color: var(--text);
    resize: vertical;
    outline: none;
  }
  input::placeholder,
  textarea::placeholder { color: var(--dim); }
  input:focus,
  textarea:focus { border-color: var(--teal); box-shadow: 0 0 0 4px rgba(45, 212, 191, .12); }
  .form .btn { justify-content: center; }

  @media (min-width: 641px) {
    .contact { padding: 52px; gap: 56px; }
    .two { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1025px) {
    .contact { grid-template-columns: 1fr 1fr; }
  }
</style>

<script src="./formulario.js"></script>
