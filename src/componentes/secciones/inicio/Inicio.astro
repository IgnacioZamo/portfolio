---
/*
  Sección Inicio (#inicio en la home): presentación, llamados a la acción
  y foto en un marco tipo ventana de editor de código.
*/
// Estilos de este componente
import "./Inicio.css";
---

<section id="inicio" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Administrativo | Desarrollador Web Jr.</span>
      <h1>¡Hola mundo!<br><span class="grad">Soy Ignacio Zamo</span></h1>
      <p class="lead">Técnico Superior en Gestión de las Organizaciones con <b>más de 10 años en administración</b>: gestión de personal, datos y documentación. Ordeno procesos, convierto números en reportes claros y sumo <b>herramientas digitales e IA</b> para trabajar mejor.</p>
      <div class="cta">
        <a href="/trayectoria" class="btn btn-primary">Ver mi trayectoria</a>
        <a href="#contacto" class="btn btn-ghost">Contactarme</a>
      </div>
      <div class="meta">
        <span class="chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          Santa Fe, Argentina
        </span>
        <span class="chip ok"><span class="pulse" aria-hidden="true"></span>Disponible para nuevas oportunidades</span>
      </div>
    </div>

    <div class="hero-card">
      <div class="win-bar" aria-hidden="true"><i></i><i></i><i></i><span>ignacio.astro</span></div>
      <!-- Imagen principal (LCP): carga inmediata, sin lazy -->
      <img class="photo" src="https://i.ibb.co/xYN1fjx/Ignacio-Zamo-Cv.jpg" alt="Foto de Ignacio Zamo" width="600" height="600" fetchpriority="high" decoding="async">
      <div class="code">
        <p><span class="k">const</span> <span class="v">ignacio</span> = &#123;</p>
        <p>&nbsp;&nbsp;perfil: <span class="s">"Administrativo"</span>,</p>
        <p>&nbsp;&nbsp;herramientas: [<span class="s">"Excel"</span>, <span class="s">"Power BI"</span>],</p>
        <p>&nbsp;&nbsp;plus: <span class="s">"Desarrollo web + IA"</span>,</p>
        <p>&nbsp;&nbsp;organizado: <span class="b">true</span></p>
        <p>&#125;;</p>
      </div>
    </div>
  </div>
</section>

