---
/*
  Sección Proyectos web (página /proyectos): intro, filtro por categoría y grilla.
  El filtro funciona con filtroProyectos.js (data-filtro / data-categoria).
*/
// Estilos de este componente
import "./Proyectos.css";
// Para sumar un proyecto alcanza con agregarlo en src/data/proyectos.json
import proyectos from "@data/proyectos.json";

const categorias = {
  proyecto: { texto: "Proyecto", clase: "" },
  practica: { texto: "Práctica", clase: "alt" },
  equipo: { texto: "En equipo", clase: "team" },
};
const filtros = [
  { valor: "todos", texto: "Todos" },
  { valor: "proyecto", texto: "Proyectos" },
  { valor: "practica", texto: "Práctica" },
  { valor: "equipo", texto: "En equipo" },
];
---

<section id="portfolio" class="section proyectos" aria-labelledby="titulo-portfolio">
  <div class="container">
    <div class="head row">
      <div class="head-copy">
        <span class="label">Mi lado developer</span>
        <!-- h1: Proyectos web es una página propia (/proyectos) -->
        <h1 id="titulo-portfolio" class="titulo-seccion">Desafiando fronteras, <span class="grad">buscando crecimiento</span></h1>
        <p class="sub">De administrador a apasionado desarrollador web. Mi último año ha sido un intenso viaje hacia la programación, transformando no solo mi carrera, sino también mi identidad. Me desafío a aprender y aportar constantemente, buscando la excelencia en cada línea de código.</p>
      </div>
      <div class="filters" role="group" aria-label="Filtrar proyectos" data-filtros>
        {filtros.map(({ valor, texto }, i) => (
          <button type="button" data-filtro={valor} aria-pressed={i === 0 ? "true" : "false"} class:list={{ on: i === 0 }}>{texto}</button>
        ))}
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-filtro-estado></p>

    <ul class="grid-projects">
      {proyectos.map((proyecto) => {
        const categoria = categorias[proyecto.categoria as keyof typeof categorias];
        return (
          <li class="project" data-categoria={proyecto.categoria}>
            <div class="shot">
              <img src={proyecto.imagen} alt={`Captura de ${proyecto.titulo}`} loading="lazy" decoding="async" width="640" height="400" />
              <span class:list={["cat", categoria.clase]}>{categoria.texto}</span>
            </div>
            <div class="body">
              <h3>{proyecto.titulo}</h3>
              <p>{proyecto.descripcion}</p>
              <div class="actions">
                <a href={proyecto.demo} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer" aria-label={`Demo de ${proyecto.titulo} (se abre en otra pestaña)`} data-evento="ver_proyecto" data-evento-proyecto={proyecto.titulo} data-evento-tipo="demo">Demo <span aria-hidden="true">↗</span></a>
                <a href={proyecto.codigo} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer" aria-label={`Código de ${proyecto.titulo} en GitHub (se abre en otra pestaña)`} data-evento="ver_proyecto" data-evento-proyecto={proyecto.titulo} data-evento-tipo="codigo"><i class="devicon-github-original" aria-hidden="true"></i> Código</a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script src="./filtroProyectos.js"></script>
