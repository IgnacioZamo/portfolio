---
/*
  Sección Sobre mí (#sobre-mi en la home): texto de perfil, 3 cifras y 4 áreas de gestión.
  Las cifras y áreas se editan en los arrays de abajo.
*/
import { iconos } from "@data/iconos.js";

const cifras = [
  { valor: "10+", texto: "años en gestión administrativa" },
  { valor: "6", texto: "empresas y emprendimientos" },
  { valor: "7", texto: "proyectos web publicados" },
];

const areas = [
  { icono: "personal", titulo: "Gestión de personal", texto: "Legajos, altas, quincenas, horas trabajadas, ART y exámenes preocupacionales." },
  { icono: "datos", titulo: "Datos y reportes", texto: "Estadísticas, indicadores y reportes mensuales con Excel y Power BI." },
  { icono: "documentacion", titulo: "Documentación y control", texto: "Archivo, registros internos, facturación y sistemas de gestión." },
  { icono: "tecnologia", titulo: "Tecnología e IA", texto: "Desarrollo web junior y asistentes de IA para automatizar tareas repetitivas." },
];
---

<section id="sobre-mi" class="section" aria-labelledby="titulo-sobre-mi">
  <div class="container">
    <div class="about card">
      <div>
        <span class="label">Sobre mí</span>
        <h2 id="titulo-sobre-mi" class="titulo-seccion">Orden, datos y procesos <span class="grad">que funcionan</span></h2>
        <p>Trabajo hace más de 10 años en administración y soporte operativo: legajos y liquidación de horas, documentación laboral, cobranzas, stock y atención al cliente. Me gusta que la información esté ordenada, actualizada y lista para decidir.</p>
        <p>Mi diferencial es el lado técnico: soy Técnico Informático, armo tableros en Power BI, bases de datos en Excel y uso desarrollo web e Inteligencia Artificial para automatizar tareas y optimizar procesos.</p>
      </div>
      <ul class="stats">
        {cifras.map(({ valor, texto }) => (
          <li><b>{valor}</b><span>{texto}</span></li>
        ))}
      </ul>
    </div>

    <ul class="areas">
      {areas.map(({ icono, titulo, texto }) => (
        <li class="area">
          <div class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={iconos[icono]} />
          </div>
          <h3>{titulo}</h3>
          <p>{texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 28px 22px;
    align-items: center;
  }
  .about p { color: var(--muted); font-size: 18px; margin-top: 20px; }
  .about p + p { margin-top: 12px; }

  .stats { display: grid; gap: 14px; }
  .stats li {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(7, 12, 22, .45);
  }
  .stats b {
    min-width: 70px;
    font: 700 38px/1 var(--f-display);
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats span { color: var(--muted); font-size: 15px; }

  .areas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 18px;
  }
  .area {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(15, 26, 44, .65);
    transition: .25s;
  }
  .area:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .area .ico { width: 44px; height: 44px; margin-bottom: 16px; }
  .area .ico svg { width: 22px; height: 22px; }
  .area h3 { font: 600 18px var(--f-display); margin-bottom: 6px; }
  .area p { color: var(--muted); font-size: 14.5px; }

  @media (min-width: 641px) {
    .about { padding: 52px; gap: 56px; }
    .areas { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1025px) {
    .about { grid-template-columns: 1.4fr 1fr; }
    .areas { grid-template-columns: repeat(4, 1fr); }
  }
</style>
