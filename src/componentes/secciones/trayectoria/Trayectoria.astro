---
/*
  Sección Trayectoria (página /trayectoria): encabezado, pestañas y paneles.
  Cada panel es un componente en ./paneles/; la lógica de pestañas está en trayectoria.js.
*/
// Estilos de este componente
import "./Trayectoria.css";
import { iconos } from "@data/iconos.js";
import PanelExperiencia from "./paneles/PanelExperiencia.astro";
import PanelFormacion from "./paneles/PanelFormacion.astro";
import PanelSkills from "./paneles/PanelSkills.astro";
import PanelTrabajos from "./paneles/PanelTrabajos.astro";

// El orden define el de las pestañas; la primera queda abierta por defecto
const pestanas = [
  { id: "experiencia", texto: "Experiencia", Panel: PanelExperiencia },
  { id: "formacion", texto: "Formación", Panel: PanelFormacion },
  { id: "skills", texto: "Skills", Panel: PanelSkills },
  { id: "trabajos", texto: "Trabajos", Panel: PanelTrabajos },
];
---

<section id="trayectoria" class="section trayectoria" aria-labelledby="titulo-trayectoria">
  <div class="container">
    <div class="head">
      <span class="label">Trayectoria</span>
      <!-- h1: Trayectoria es una página propia (/trayectoria) -->
      <h1 id="titulo-trayectoria" class="titulo-seccion">Mi recorrido profesional</h1>
      <p class="sub">Experiencia, formación y herramientas en un solo lugar. Más de 10 años en administración y soporte operativo, con el plus de la tecnología.</p>
    </div>

    <div class="tabs" role="tablist" aria-label="Trayectoria" data-tabs>
      {pestanas.map(({ id, texto }, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${id}`}
          data-tab={id}
          aria-controls={`panel-${id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class:list={{ on: i === 0 }}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={iconos[id]} />
          {texto}
        </button>
      ))}
      <span class="tab-ink" aria-hidden="true"></span>
    </div>

    <div class="panels">
      {pestanas.map(({ id, Panel }, i) => (
        <div class={`panel panel-${id}`} id={`panel-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} tabindex="0" hidden={i !== 0}>
          <Panel />
        </div>
      ))}
    </div>
  </div>
</section>

<script src="./trayectoria.js"></script>
