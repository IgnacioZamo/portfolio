---
// Estilos de este componente
import "./PanelExperiencia.css";
// Para sumar un puesto alcanza con agregarlo (arriba de todo) en src/data/experiencia.json
import experiencia from "@data/experiencia.json";
---

<ol class="timeline">
  {experiencia.map((puesto) => (
    <li class:list={["tl-item", { current: puesto.actual }]}>
      <article class="tl-card">
        <span class="tl-date">{puesto.desde} — {puesto.hasta}</span>
        <header>
          <h3>{puesto.puesto}{puesto.modalidad && <em> ({puesto.modalidad})</em>}</h3>
          <p class="company">{puesto.empresa}</p>
        </header>
        <ul class="tareas">
          {puesto.tareas.map((tarea) => <li>{tarea}</li>)}
        </ul>
        <ul class="tags" aria-label="Temas">
          {puesto.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    </li>
  ))}
</ol>

