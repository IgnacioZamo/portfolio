---
// Estilos de este componente
import "./PanelFormacion.css";
// Títulos y cursos se cargan desde src/data/formacion.json
import formacion from "@data/formacion.json";

const grupos = [
  { titulo: "Títulos", items: formacion.titulos, destacado: true },
  { titulo: "Cursos", items: formacion.cursos, destacado: false },
];
---

{grupos.map(({ titulo, items, destacado }) => (
  <>
    <h3 class="group">{titulo}</h3>
    <div class:list={["edu-grid", { "two-col": destacado }]}>
      {items.map((item) => (
        <article class:list={["edu", { featured: destacado }]}>
          <span class="edu-year">{item.periodo}</span>
          <h4>{item.titulo}</h4>
          <p class="company">{item.institucion} · {item.nivel}</p>
          <ul>
            {item.puntos.map((punto) => <li>{punto}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </>
))}

