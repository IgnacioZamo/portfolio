---
// Las listas de herramientas y habilidades viven en src/data/skills.json
import skills from "../../data/skills.json";
import { iconos } from "../../data/iconos.js";
---

<h3 class="group">Gestión administrativa</h3>
<ul class="admin-skills">
  {skills.gestion.map(({ titulo, texto }) => (
    <li class="as"><b>{titulo}</b><span>{texto}</span></li>
  ))}
</ul>

<h3 class="group">Herramientas de oficina y datos</h3>
<ul class="skills five">
  {skills.oficina.map((herramienta) => (
    <li class="skill">
      <span class={`tool ${herramienta.clase}`} aria-hidden="true">
        {herramienta.icono
          ? <svg viewBox="0 0 24 24" fill={herramienta.icono === "powerbi" ? "currentColor" : "none"} stroke={herramienta.icono === "powerbi" ? "none" : "currentColor"} stroke-width="2" set:html={iconos[herramienta.icono]} />
          : herramienta.letra}
      </span>
      <span>{herramienta.nombre}{herramienta.nivel && <small>{herramienta.nivel}</small>}</span>
    </li>
  ))}
</ul>

<h3 class="group">Desarrollo web <small>(nivel junior)</small></h3>
<ul class="skills small">
  {skills.web.map(({ nombre, icono }) => (
    <li class="skill"><i class={icono} aria-hidden="true"></i><span>{nombre}</span></li>
  ))}
</ul>

<h3 class="group">Soft skills</h3>
<ul class="soft">
  {skills.blandas.map(({ titulo, texto, icono }) => (
    <li class="soft-card">
      <div class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={iconos[icono]} />
      </div>
      <h4>{titulo}</h4>
      <p>{texto}</p>
    </li>
  ))}
</ul>

<style>
  ul { list-style: none; }
  .group {
    margin: 8px 0 18px;
    font: 600 14px var(--f-mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  ul ~ .group { margin-top: 36px; }
  .group small { text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--dim); }

  /* Gestión administrativa */
  .admin-skills { display: grid; grid-template-columns: 1fr; gap: 14px; margin-bottom: 8px; }
  .as {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 20px 22px;
    border-left: 3px solid var(--teal);
    border-radius: 12px;
    background: rgba(15, 26, 44, .7);
  }
  .as b { font: 600 16px var(--f-display); }
  .as span { color: var(--muted); font-size: 14px; }

  /* Grillas de herramientas */
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 40px; }
  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 18px 6px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: rgba(15, 26, 44, .65);
    transition: .25s;
  }
  .skill:hover { border-color: var(--line-strong); transform: translateY(-4px); }
  .skill i { font-size: 36px; }
  .skill > span:last-child { font-weight: 600; font-size: 15px; text-align: center; }
  .skill small { display: block; margin-top: 2px; font-size: 12px; font-weight: 500; color: var(--muted); }
  .skills.small .skill { padding: 20px 8px; }
  .skills.small .skill i { font-size: 38px; }
  .icono-claro { color: var(--text); }
  .icono-astro { color: #FF5D01; }

  .tool {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    font: 700 22px var(--f-display);
    color: #fff;
  }
  .tool svg { width: 24px; height: 24px; }
  .tool.xl { background: #107C41; }
  .tool.bi { background: #F2C811; color: #1B1B1B; }
  .tool.wd { background: #185ABD; }
  .tool.gw { background: conic-gradient(#EA4335 0 25%, #FBBC04 0 50%, #34A853 0 75%, #4285F4 0); }
  .tool.sp { background: #334155; }

  /* Soft skills */
  .soft { display: grid; grid-template-columns: 1fr; gap: 18px; }
  .soft-card {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: rgba(15, 26, 44, .65);
    transition: .25s;
  }
  .soft-card:hover { border-color: var(--line-strong); }
  .soft-card .ico { width: 48px; height: 48px; margin-bottom: 18px; }
  .soft-card .ico svg { width: 24px; height: 24px; }
  .soft-card h4 { font: 600 19px var(--f-display); margin-bottom: 8px; }
  .soft-card p { color: var(--muted); font-size: 15px; }

  @media (min-width: 641px) {
    .admin-skills { grid-template-columns: repeat(2, 1fr); }
    .skills { gap: 16px; }
    .skill { padding: 26px 10px; }
    .skill i { font-size: 46px; }
    .soft { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1025px) {
    .admin-skills { grid-template-columns: repeat(4, 1fr); }
    .skills { grid-template-columns: repeat(5, 1fr); }
    .soft { grid-template-columns: repeat(3, 1fr); }
  }
</style>
